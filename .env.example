# Dev-only credentials, matching compose.yaml. Replace them everywhere else.
DATABASE_URL=postgres://agent_app:agent_app_dev_password@127.0.0.1:5432/agent
MIGRATION_DATABASE_URL=postgres://agent_owner:agent_owner_dev_password@127.0.0.1:5432/agent

# The notes API the agent acts on. Callers send its tokens, and tools run with them.
NOTES_API_URL=http://127.0.0.1:3100
NOTES_API_TIMEOUT_MS=5000

# Get a key at https://platform.claude.com. Never commit it.
ANTHROPIC_API_KEY=
AGENT_MODEL=anthropic/claude-sonnet-5-5
# Checks each message for prompt injection. Set to off to skip the check.
GUARDRAIL_MODEL=anthropic/claude-haiku-5-5

AGENT_MAX_STEPS=8
AGENT_MAX_OUTPUT_TOKENS=4096
AGENT_RUN_TIMEOUT_MS=120000
AGENT_MEMORY_MESSAGES=20
DAILY_TOKEN_BUDGET=500000

# Finished runs and token usage are deleted after this many days.
RUN_RETENTION_DAYS=30
# An approval nobody answers fails after this many hours, which unlocks its thread.
APPROVAL_TTL_HOURS=24

PORT=3000
LOG_LEVEL=info
DATABASE_STATEMENT_TIMEOUT_MS=5000

# Comma-separated browser origins. Leave empty to disable CORS.
CORS_ORIGINS=

# Set to true only behind a proxy that appends to X-Forwarded-For.
TRUST_PROXY=false

RATE_LIMIT_PER_MINUTE=300
AGENT_RATE_LIMIT_PER_MINUTE=20

# Set to send traces to an OTLP collector over HTTP.
OTEL_EXPORTER_OTLP_ENDPOINT=
