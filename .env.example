# Dev-only credentials, matching compose.yaml. Replace them everywhere else.
# An empty value counts as unset, so the default applies.
DATABASE_URL=postgres://agent_app:agent_app_dev_password@127.0.0.1:5432/agent
MIGRATION_DATABASE_URL=postgres://agent_owner:agent_owner_dev_password@127.0.0.1:5432/agent

# The notes API the agent acts on. Callers send its tokens, and tools run with them.
NOTES_API_URL=http://127.0.0.1:3100
NOTES_API_TIMEOUT_MS=5000

# Get a key at https://platform.claude.com. Never commit it.
ANTHROPIC_API_KEY=
AGENT_MODEL=anthropic/claude-sonnet-5-5
# Checks each message for prompt injection. Set to off to skip the check.
GUARDRAIL_MODEL=anthropic/claude-haiku-5-5
# block refuses a message when the check itself fails. allow lets it through.
GUARDRAIL_ON_ERROR=block

AGENT_MAX_STEPS=8
# Per model call, thinking included.
AGENT_MAX_OUTPUT_TOKENS=16000
AGENT_RUN_TIMEOUT_MS=120000
AGENT_MEMORY_MESSAGES=20
DAILY_TOKEN_BUDGET=500000
# Most tokens one run may spend. Starting a run reserves this much of the daily budget.
AGENT_RUN_TOKEN_LIMIT=100000
AGENT_MAX_CONCURRENT_RUNS=3

# Finished runs and token usage are deleted after this many days.
RUN_RETENTION_DAYS=30
# Threads nobody used for this many days are deleted with their messages. 0 keeps them.
THREAD_RETENTION_DAYS=90
# An approval nobody answers fails after this many hours, which unlocks its thread.
APPROVAL_TTL_HOURS=24

PORT=3000
# debug, info, warn, error, or silent.
LOG_LEVEL=info
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_POOL_MAX=10

# Comma-separated browser origins. Leave empty to disable CORS.
CORS_ORIGINS=

# How many proxies in front of the server append to X-Forwarded-For. 0 uses the socket address.
TRUST_PROXY_HOPS=0

RATE_LIMIT_PER_MINUTE=300
AGENT_RATE_LIMIT_PER_MINUTE=20

# Serves /docs and /openapi.json. Leave it off in production unless you mean to publish them.
DOCS_ENABLED=true

# On SIGTERM: fail /readyz for this long, then give runs in flight this long before aborting them.
SHUTDOWN_DRAIN_SECONDS=5
SHUTDOWN_TIMEOUT_SECONDS=30

# Set to send traces and metrics to an OTLP collector over HTTP.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Puts prompts, replies, and tool data in trace spans. Keep it off where traces aren't private.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
