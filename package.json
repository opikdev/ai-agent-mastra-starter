{
  "name": "ai-agent-mastra-starter",
  "version": "0.2.0",
  "private": true,
  "description": "Production-ready AI agent API in TypeScript with Mastra and Claude: tools, approvals, memory, guardrails, budgets, and evals",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch src/index.ts",
    "start": "node --import ./src/instrumentation.ts src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "scripts/check-migrations.sh",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.ts",
    "format": "biome format --write .",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "eval": "node --env-file-if-exists=.env evals/cli.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm db:check && pnpm test:coverage && .agents/check.sh && .github/scripts/check-repo-standards.sh",
    "openapi:generate": "node scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@hono/otel": "^1.3.0",
    "@hono/zod-openapi": "^1.6.3",
    "@mastra/core": "1.82.0",
    "@mastra/evals": "^1.10.11",
    "@mastra/loggers": "^1.3.10",
    "@mastra/memory": "^1.41.0",
    "@mastra/observability": "^1.23.1",
    "@mastra/otel-exporter": "^1.5.1",
    "@mastra/pg": "^1.35.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.1",
    "@opentelemetry/instrumentation-pg": "^0.78.0",
    "@opentelemetry/sdk-node": "^0.301.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "swagger-ui-dist": "5.34.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@opentelemetry/core": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "^0.31.11",
    "testcontainers": "^12.2.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
